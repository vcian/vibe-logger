{
  "name": "@vcian/vibe-logger",
  "version": "1.0.0",
  "description": "Drop-in log viewer UI and dashboard for Node.js, Express, and NestJS — search, filter, date-range queries, time-series chart, CSV export, JWT auth, and pluggable memory/file storage for Winston/Pino-style JSON logs.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "bin": {
    "vibe-logger": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "ts-node src/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/ui/**/*.{html,css,js}\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "release": "npm run prepublishOnly && npm publish"
  },
  "keywords": [
    "logger",
    "log-viewer",
    "log-dashboard",
    "log-ui",
    "log-explorer",
    "log-analyzer",
    "log-search",
    "log-management",
    "log-monitoring",
    "logs",
    "logging",
    "application-logs",
    "server-logs",
    "json-logs",
    "winston",
    "pino",
    "morgan",
    "bunyan",
    "express",
    "express-middleware",
    "nestjs",
    "nestjs-logger",
    "nodejs",
    "node",
    "typescript",
    "middleware",
    "dashboard",
    "debugging",
    "debug",
    "monitoring",
    "observability",
    "devops",
    "error-tracking",
    "chart",
    "time-series",
    "csv-export",
    "authentication",
    "jwt",
    "self-hosted",
    "real-time-logs"
  ],
  "author": {
    "name": "vcian",
    "url": "https://github.com/vcian"
  },
  "license": "MIT",
  "homepage": "https://github.com/vcian/vibe-logger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcian/vibe-logger.git"
  },
  "bugs": {
    "url": "https://github.com/vcian/vibe-logger/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "express": ">=4.18.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.0.0",
    "express-rate-limit": "^7.0.0",
    "jsonwebtoken": "^9.0.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "minimatch": ">=9.0.5",
    "vite": ">=6.4.2",
    "qs": ">=6.15.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}

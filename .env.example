LOG_AUTH_ENABLED=true
LOG_USERNAME=admin
LOG_PASSWORD_HASH=
LOG_JWT_SECRET=change-this-to-a-long-random-string
LOG_SESSION_TTL=3600
LOG_MAX_ATTEMPTS=5
LOG_LOCKOUT_MINS=15
# Optional multi-user JSON array:
# LOG_USERS=[{"username":"admin","passwordHash":"$2a$10$...","role":"admin"}]
LOG_USERS=
LOG_VIEWER_PATH=/logs
LOG_MAX_ENTRIES=10000
# Set to file to ingest Winston JSON logs from files.
LOG_STORAGE_MODE=memory

# Single-file mode (default if LOG_FILE_GLOB is not set):
LOG_FILE_PATH=logs/app.log

# Multi-file mode (daily rotate): if set, overrides LOG_FILE_PATH.
# Example: LOG_FILE_GLOB=logs/*.log
LOG_FILE_GLOB=
# Number of days (based on YYYY-MM-DD in filenames) to include in multi-file mode.
LOG_FILE_DAYS=30

LOG_FILE_LIVE_TAIL=true
